{
  "APP_NAME": "RELECOV Platform",
  "APP_SLUG": "relecov-platform",
  "DESCRIPTION": "Integrated RELECOV metadata, validation, submission, LIMS, and visualization platform.",
  "REPOSITORY_URL": "https://github.com/BU-ISCIII/relecov-platform.git",
  "DEFAULT_BRANCH": "develop",
  "PYTHON_VERSION": "3.11",
  "TIMEZONE": "Europe/Madrid",
  "SERVICES": {
    "app": {
      "PROFILE": "django",
      "BUILD_CONTEXT": ".",
      "DOCKERFILE": "Dockerfile",
      "IMAGE": "relecov-platform:local",
      "INSTALL_CONF": "conf/docker_production_settings.txt",
      "TEST_INSTALL_CONF": "conf/docker_test_settings.txt",
      "PROJECT_MODULE": "relecov_platform"
    },
    "iskylims_app": {
      "PROFILE": "django",
      "BUILD_CONTEXT": "../relecov-iskylims",
      "DOCKERFILE": "Dockerfile",
      "IMAGE": "relecov-iskylims:local",
      "INSTALL_CONF": "../relecov-iskylims/conf/docker_production_settings.txt",
      "TEST_INSTALL_CONF": "../relecov-iskylims/conf/docker_test_settings.txt",
      "PROJECT_MODULE": "iskylims"
    }
  },
  "ADDONS": {
    "apache": {
      "CONFIG_SERVICE": "app"
    },
    "nextstrain": {
      "CONFIG_SERVICE": "app"
    },
    "samba": {
      "CONFIG_SERVICE": "iskylims_app",
      "MODES": [
        "test"
      ]
    }
  }
}
